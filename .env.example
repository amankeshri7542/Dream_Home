# Dream Home server settings. Copy to .env.local for `npm run dev`; on Vercel,
# set them in Project → Settings → Environment Variables. All are optional:
# without an AI key the app uses its built-in planner.

# --- AI -----------------------------------------------------------------
# Server-side only; never exposed to the browser.
ANTHROPIC_API_KEY=
# Model for the AI home designer (default claude-opus-5-5).
AI_MODEL=
# Model that reads a photo of a builder's plan (default claude-sonnet-5-5).
PLAN_MODEL=
# Total AI spend allowed per day, in US dollars (default 10).
AI_DAILY_BUDGET_USD=10
# Kill switch: set to 1 to turn every AI feature off at once (the app keeps
# working with its built-in planner).
AI_DISABLED=

# --- Limits store (required on Vercel) ------------------------------------
# Upstash Redis / Vercel KV REST credentials, added automatically when you
# connect the Upstash integration. Without them, a Vercel deployment refuses
# AI work (per-instance memory can't enforce limits or the budget) and share
# links (which keep their records here).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Share links (required on Vercel for sharing) ---------------------------
# Vercel Blob store token, added automatically when you create a Blob store
# and connect it to the project. Shared homes and their preview pictures are
# stored privately and served only through /api/share.
BLOB_READ_WRITE_TOKEN=
# A long random secret (at least 24 characters) that lets the site owner hide,
# unhide or delete any shared home. See docs/SECURITY.md. Never share it.
ADMIN_TOKEN=

# --- Origins --------------------------------------------------------------
# The public address of the app, used for share links and same-site checks.
PUBLIC_ORIGIN=https://home.amankeshri.com
# The same address for the browser (read at build time; not a secret). Once
# set, the old *.vercel.app address shows a "Move my home" banner that carries
# the open home to the new address inside the link. Leave empty until the new
# domain works.
VITE_PUBLIC_ORIGIN=
# Extra origins allowed to call the API (comma-separated), e.g. the old
# vercel.app address while homes move to the new domain.
ALLOWED_ORIGINS=

# --- Limit overrides -------------------------------------------------------
# LIMIT_<KIND>_DEVICE: uses per device (lifetime for home/room/plan, per day
# for the rest). LIMIT_<KIND>_IP: uses per connection per day.
# Kinds and defaults:
#   home    3 per device (lifetime),  8 per connection per day
#   room   10 per device (lifetime), 30 per connection per day
#   command 15 per device per day,   60 per connection per day
#   plan    1 per device (lifetime),  3 per connection per day
#   share  20 per device per day,    60 per connection per day
#   report 10 per device per day,    20 per connection per day
#   read   no device limit,         600 per connection per day
# Example:
# LIMIT_COMMAND_DEVICE=15
# LIMIT_PLAN_DEVICE=1
