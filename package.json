{
  "name": "dream-home",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && node scripts/build-api.mjs && vite build",
    "build:api": "node scripts/build-api.mjs",
    "check:api": "node scripts/build-api.mjs && git diff --exit-code -- api/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "assets": "node scripts/assets/build.mjs",
    "assets:blender": "node scripts/assets/build.mjs --step blender",
    "assets:pack": "node scripts/assets/build.mjs --step pack",
    "test:preview": "playwright test -c playwright.preview.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.2.0",
    "lucide-react": "^0.468.0",
    "postprocessing": "^6.39.5",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "gltfpack": "^1.3.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
